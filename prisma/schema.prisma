generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model StaffMember {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("Staff")
  clanName     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     StaffSession[]
}

model StaffSession {
  id        String      @id @default(cuid())
  token     String      @unique
  staffId   String
  staff     StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime    @default(now())
}

model SiteContent {
  key       String   @id
  data      String
  updatedBy String?
  updatedAt DateTime @updatedAt
}
